{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "jsx": "preserve",
        "strict": false,
        "skipLibCheck": true,
        "baseUrl": "."
    },
    "include": [
        "**/*.ts",
        "**/*.vue",
        "types/**/*.d.ts"
    ]
}